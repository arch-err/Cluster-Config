{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["repoURL", "targetRevision", "owner", "render"],
  "properties": {
    "repoURL": {"type": "string", "minLength": 1},
    "targetRevision": {"type": "string", "minLength": 1},
    "owner": {"enum": ["apps", "infra"]},
    "render": {"enum": ["resources", "secrets"]}
  }
}
