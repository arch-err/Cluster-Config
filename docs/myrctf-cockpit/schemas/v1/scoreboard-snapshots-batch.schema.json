{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrctf.3rr.dev/schemas/ctfd-cockpit/v1/scoreboard-snapshots-batch.schema.json",
  "title": "CTFd Cockpit v1 scoreboard snapshot batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_instance",
    "stream",
    "batch_id",
    "sequence",
    "checkpoint",
    "source_event_time",
    "snapshot_key",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_instance": {"$ref": "common.schema.json#/$defs/sourceInstance"},
    "stream": {"const": "scoreboard_snapshots"},
    "batch_id": {"$ref": "common.schema.json#/$defs/batchId"},
    "sequence": {"$ref": "common.schema.json#/$defs/checkpoint"},
    "checkpoint": {"$ref": "common.schema.json#/$defs/checkpoint"},
    "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"},
    "snapshot_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "records": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["team_id", "rank", "score"],
        "properties": {
          "team_id": {"$ref": "common.schema.json#/$defs/id"},
          "rank": {"type": "integer", "minimum": 1},
          "score": {"type": "integer"},
          "bracket": {"$ref": "common.schema.json#/$defs/shortText"}
        }
      }
    }
  }
}
