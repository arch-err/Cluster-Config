{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrctf.3rr.dev/schemas/ctfd-cockpit/v1/entities.schema.json",
  "title": "CTFd Cockpit v1 entity and event records",
  "$defs": {
    "mutableMetadata": {
      "type": "object",
      "required": ["source_updated_at"],
      "properties": {
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "eventMetadata": {
      "type": "object",
      "required": ["source_table", "source_id", "source_event_time"],
      "properties": {
        "source_table": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$"
        },
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "username", "verified", "hidden", "banned", "custom_fields", "source_updated_at"],
      "properties": {
        "user_id": {"$ref": "common.schema.json#/$defs/id"},
        "username": {"type": "string", "minLength": 1, "maxLength": 128},
        "email": {"type": ["string", "null"], "format": "email", "maxLength": 320},
        "oauth_id": {"$ref": "common.schema.json#/$defs/shortText"},
        "name": {"$ref": "common.schema.json#/$defs/shortText"},
        "website": {"$ref": "common.schema.json#/$defs/shortText"},
        "affiliation": {"$ref": "common.schema.json#/$defs/shortText"},
        "country": {"$ref": "common.schema.json#/$defs/shortText"},
        "bracket": {"$ref": "common.schema.json#/$defs/shortText"},
        "user_type": {"$ref": "common.schema.json#/$defs/shortText"},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "verified": {"type": "boolean"},
        "hidden": {"type": "boolean"},
        "banned": {"type": "boolean"},
        "custom_fields": {"$ref": "common.schema.json#/$defs/customFields"},
        "registered_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "last_active_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "name", "hidden", "banned", "custom_fields", "source_updated_at"],
      "properties": {
        "team_id": {"$ref": "common.schema.json#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "email": {"type": ["string", "null"], "format": "email", "maxLength": 320},
        "captain_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "website": {"$ref": "common.schema.json#/$defs/shortText"},
        "affiliation": {"$ref": "common.schema.json#/$defs/shortText"},
        "country": {"$ref": "common.schema.json#/$defs/shortText"},
        "bracket": {"$ref": "common.schema.json#/$defs/shortText"},
        "team_type": {"$ref": "common.schema.json#/$defs/shortText"},
        "hidden": {"type": "boolean"},
        "banned": {"type": "boolean"},
        "custom_fields": {"$ref": "common.schema.json#/$defs/customFields"},
        "registered_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "last_active_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "teamMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_id", "user_id", "source_updated_at"],
      "properties": {
        "source_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"$ref": "common.schema.json#/$defs/id"},
        "user_id": {"$ref": "common.schema.json#/$defs/id"},
        "joined_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_id", "name", "challenge_type", "source_updated_at"],
      "properties": {
        "challenge_id": {"$ref": "common.schema.json#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "category": {"$ref": "common.schema.json#/$defs/shortText"},
        "description": {"$ref": "common.schema.json#/$defs/longText"},
        "connection_info": {"$ref": "common.schema.json#/$defs/longText"},
        "challenge_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "state": {"$ref": "common.schema.json#/$defs/shortText"},
        "value": {"type": ["integer", "null"]},
        "initial_value": {"type": ["integer", "null"]},
        "minimum_value": {"type": ["integer", "null"]},
        "decay": {"type": ["integer", "null"]},
        "max_attempts": {"type": ["integer", "null"], "minimum": 0},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prerequisites": {
              "type": "array",
              "maxItems": 256,
              "items": {"$ref": "common.schema.json#/$defs/id"}
            },
            "anonymize": {"type": "boolean"}
          }
        },
        "created_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "challengeTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_id", "challenge_id", "value", "source_updated_at"],
      "properties": {
        "tag_id": {"$ref": "common.schema.json#/$defs/id"},
        "challenge_id": {"$ref": "common.schema.json#/$defs/id"},
        "value": {"type": "string", "maxLength": 256},
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hint_id", "challenge_id", "source_updated_at"],
      "properties": {
        "hint_id": {"$ref": "common.schema.json#/$defs/id"},
        "challenge_id": {"$ref": "common.schema.json#/$defs/id"},
        "content": {"$ref": "common.schema.json#/$defs/longText"},
        "cost": {"type": ["integer", "null"]},
        "hint_type": {"$ref": "common.schema.json#/$defs/shortText"},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prerequisites": {
              "type": "array",
              "maxItems": 256,
              "items": {"$ref": "common.schema.json#/$defs/id"}
            },
            "anonymize": {"type": "boolean"}
          }
        },
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "draft", "hidden", "auth_required", "source_updated_at"],
      "properties": {
        "page_id": {"$ref": "common.schema.json#/$defs/id"},
        "title": {"$ref": "common.schema.json#/$defs/shortText"},
        "route": {"$ref": "common.schema.json#/$defs/shortText"},
        "content": {"$ref": "common.schema.json#/$defs/longText"},
        "draft": {"type": "boolean"},
        "hidden": {"type": "boolean"},
        "auth_required": {"type": "boolean"},
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "challengeInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "state", "source_updated_at"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "challenge_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "state": {"type": "string", "minLength": 1, "maxLength": 64},
        "failure_class": {"$ref": "common.schema.json#/$defs/shortText"},
        "connection_info": {"$ref": "common.schema.json#/$defs/longText"},
        "created_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "started_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "expires_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "stopped_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "source_updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_table", "source_id", "attempted_value", "result_type", "source_event_time", "challenge_id"],
      "properties": {
        "source_table": {"const": "submissions"},
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "attempted_value": {"$ref": "common.schema.json#/$defs/longText"},
        "result_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "submission_type": {"$ref": "common.schema.json#/$defs/shortText"},
        "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "challenge_id": {"$ref": "common.schema.json#/$defs/id"},
        "source_ip": {"$ref": "common.schema.json#/$defs/ipAddress"},
        "points": {"type": ["integer", "null"]}
      }
    },
    "solve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_table", "source_id", "challenge_id", "source_event_time"],
      "properties": {
        "source_table": {"const": "solves"},
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "submission_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "challenge_id": {"$ref": "common.schema.json#/$defs/id"},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "source_ip": {"$ref": "common.schema.json#/$defs/ipAddress"},
        "points": {"type": ["integer", "null"]},
        "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_table", "source_id", "value", "source_event_time"],
      "properties": {
        "source_table": {"const": "awards"},
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "name": {"$ref": "common.schema.json#/$defs/shortText"},
        "description": {"$ref": "common.schema.json#/$defs/longText"},
        "category": {"$ref": "common.schema.json#/$defs/shortText"},
        "value": {"type": "integer"},
        "icon": {"$ref": "common.schema.json#/$defs/shortText"},
        "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "hintUnlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_table", "source_id", "hint_id", "source_event_time"],
      "properties": {
        "source_table": {"const": "unlocks"},
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "hint_id": {"$ref": "common.schema.json#/$defs/id"},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "cost": {"type": ["integer", "null"]},
        "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "trackingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_table", "source_id", "event_type", "source_event_time"],
      "properties": {
        "source_table": {"const": "tracking"},
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "event_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "source_ip": {"$ref": "common.schema.json#/$defs/ipAddress"},
        "path": {"$ref": "common.schema.json#/$defs/shortText"},
        "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_table", "source_id", "source_event_time"],
      "properties": {
        "source_table": {"const": "notifications"},
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "title": {"$ref": "common.schema.json#/$defs/shortText"},
        "content": {"$ref": "common.schema.json#/$defs/longText"},
        "notification_type": {"$ref": "common.schema.json#/$defs/shortText"},
        "sound": {"type": ["boolean", "null"]},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "team_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/id"}, {"type": "null"}]},
        "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    }
  }
}
