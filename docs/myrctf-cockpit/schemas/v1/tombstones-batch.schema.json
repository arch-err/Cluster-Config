{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myrctf.3rr.dev/schemas/ctfd-cockpit/v1/tombstones-batch.schema.json",
  "title": "CTFd Cockpit v1 deletion tombstone batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_instance",
    "stream",
    "batch_id",
    "sequence",
    "checkpoint",
    "source_event_time",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_instance": {"$ref": "common.schema.json#/$defs/sourceInstance"},
    "stream": {"const": "tombstones"},
    "batch_id": {"$ref": "common.schema.json#/$defs/batchId"},
    "sequence": {"$ref": "common.schema.json#/$defs/checkpoint"},
    "checkpoint": {"$ref": "common.schema.json#/$defs/checkpoint"},
    "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"},
    "records": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_table", "source_id", "source_event_time"],
        "properties": {
          "source_table": {
            "enum": [
              "users",
              "teams",
              "team_members",
              "challenges",
              "tags",
              "submissions",
              "solves",
              "awards",
              "hints",
              "unlocks",
              "tracking",
              "notifications",
              "pages",
              "scoreboard_snapshots",
              "challenge_instances"
            ]
          },
          "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "source_event_time": {"$ref": "common.schema.json#/$defs/timestamp"},
          "reason": {"type": ["string", "null"], "maxLength": 256}
        }
      }
    }
  }
}
